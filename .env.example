# Database (REQUIRED on Vercel — use MongoDB Atlas connection string)
# This app uses Mongoose/MongoDB, not Supabase tables.
MONGODB_URI=mongodb://127.0.0.1:27017/futurecard
# Example Atlas:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/futurecard?retryWrites=true&w=majority

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32

# File Upload (optional — URL paste works without these)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Custom domains — comma-separated platform hosts (no protocol).
# Requests to any other Host are treated as tenant custom domains.
PLATFORM_HOSTS=localhost,127.0.0.1,app.futurecard.pro
NEXT_PUBLIC_PLATFORM_HOST=app.futurecard.pro
NEXT_PUBLIC_PLATFORM_CNAME_TARGET=app.futurecard.pro

# Seed accounts
SEED_ADMIN_EMAIL=admin@futurecard.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_USER_EMAIL=demo@futurecard.local
SEED_USER_PASSWORD=Demo@123456

# Optional: only if migrating off Mongo to Supabase (not used by current code)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=