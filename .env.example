# Database — Supabase (REQUIRED on Vercel)
# Create a project at https://supabase.com → Settings → API
#
# 1. Run SQL in supabase/migrations/001_init.sql (SQL Editor → New query → Run)
#    Then run supabase/migrations/002_ambient_background.sql for shell video/slideshow
#    Then run supabase/migrations/003_storage_media.sql for profile/media uploads
# 2. Copy Project URL + service_role key (server only) into Vercel env
#
# Use the service_role key for this app (NextAuth + server routes bypass RLS).
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upload driver: omit for auto | supabase | local
# On Vercel, uploads always use Supabase Storage (local public/ is not writable).
# UPLOAD_DRIVER=supabase

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Required on Vercel (Production). Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Optional alias — used if NEXTAUTH_SECRET is unset
# AUTH_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Custom domains — comma-separated platform hosts (no protocol).
# Requests to any other Host are treated as tenant custom domains.
PLATFORM_HOSTS=localhost,127.0.0.1,app.futurecard.pro
NEXT_PUBLIC_PLATFORM_HOST=app.futurecard.pro
NEXT_PUBLIC_PLATFORM_CNAME_TARGET=app.futurecard.pro

# Seed accounts
SEED_ADMIN_EMAIL=admin@futurecard.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_USER_EMAIL=demo@futurecard.local
SEED_USER_PASSWORD=Demo@123456
