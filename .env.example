# Database — Supabase (REQUIRED on Vercel)
# Create a project at https://supabase.com → Settings → API
#
# 1. Run SQL in supabase/migrations/001_init.sql (SQL Editor → New query → Run)
#    Then run remaining migrations in order (002 … 012) as needed
# 2. Copy Project URL + service_role key (server only) into Vercel env
#
# Use the Project URL (https://YOUR_PROJECT.supabase.co) — NOT the Postgres
# pooler host (*.pooler.supabase.com) or a postgres:// connection string.
# This app talks to PostgREST via @supabase/supabase-js; Supabase pools that
# path for you. Optional fetch retries are built into the server client.
#
# Prefer the service_role / secret key for this app (NextAuth + server routes
# bypass RLS). Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Optional alias if you omit NEXT_PUBLIC_SUPABASE_URL:
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional aliases:
# SUPABASE_ANON_KEY=your-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional alias (newer Supabase secret key naming):
# SUPABASE_SECRET_KEY=your-service-role-key

# Upload driver: omit for auto | supabase | local
# On Vercel, uploads always use Supabase Storage (local public/ is not writable).
# UPLOAD_DRIVER=supabase

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Required on Vercel (Production). Generate: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Optional alias — used if NEXTAUTH_SECRET is unset
# AUTH_SECRET=

# App — MUST be your live URL on Vercel (used for links/QR when SSR has no window)
# On the client, QR codes prefer window.location.origin automatically.
NEXT_PUBLIC_APP_URL=https://futurecard.online

# Custom domains — comma-separated platform hosts (no protocol).
# These hosts serve the SaaS app (landing / login / dashboard).
# Any OTHER host is treated as a tenant custom domain → public card lookup.
# *.vercel.app and VERCEL_PROJECT_PRODUCTION_URL are always platform hosts.
PLATFORM_HOSTS=localhost,127.0.0.1,futurecard.online,app.futurecard.pro
NEXT_PUBLIC_PLATFORM_HOST=futurecard.online
NEXT_PUBLIC_PLATFORM_CNAME_TARGET=futurecard.online

# Seed accounts
SEED_ADMIN_EMAIL=admin@futurecard.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_USER_EMAIL=demo@futurecard.local
SEED_USER_PASSWORD=Demo@123456
